# Database Configuration
# Use 'mysql' when running `docker compose up -d`
# Use '127.0.0.1' or your remote host when running the app outside Docker
NODE_ENV=production
PORT=3000
API_PORT=3001

# Banco existente no Dokploy
DB_HOST=iptv-iptvdb-smznrv
DB_PORT=3306
DB_USER=root
DB_PASSWORD=troque-esta-senha
DB_NAME=DBStream

# Segredos da aplicacao
JWT_SECRET=78992b15d6fb48295e46e023ab626fdf10e327ad30d847c5ca06b9c18d7dc398
JWT_EXPIRES_IN=7d
NEXTAUTH_SECRET=71e26be8910a92f63d1419698e4a4496985c07b636702da7741805c6e0165408

# Dominio publico da aplicacao
NEXTAUTH_URL=https://iptv.kmkzclan.com
APP_URL=https://iptv.kmkzclan.com
CORS_ORIGIN=https://iptv.kmkzclan.com

# API interna no mesmo container
API_URL=http://iptv.kmkzclan.com:3001
SESSION_COOKIE_SECURE=true

# Application Configuration
APP_NAME=IPTV Manager
APP_DESCRIPTION=Sistema de Gerenciamento de IPTV

# Dokploy / VPS Notes:
# - Build Type: Railpack
# - The public app runs on PORT automatically injected by Dokploy
# - Keep API_PORT=3001 so Next.js proxies `/api/*` internally to Express
# - In production, set API_URL=http://127.0.0.1:3001
# - In production, set APP_URL/NEXTAUTH_URL/CORS_ORIGIN to https://seu-dominio.com
# - In production, set SESSION_COOKIE_SECURE=true
