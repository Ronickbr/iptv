# Database Configuration
# Use 'mysql' for Docker environment, 'localhost' for local development
DB_HOST=mysql
DB_PORT=3306
DB_USER=iptv_user
DB_PASSWORD=iptv_password
DB_NAME=iptv_manager

# JWT Configuration
JWT_SECRET=replace-with-a-random-secret-with-at-least-32-characters
JWT_EXPIRES_IN=7d

# Next.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret-with-at-least-32-characters

# API Configuration
API_URL=http://localhost:3001

# Application Configuration
APP_NAME=IPTV Manager
APP_DESCRIPTION=Sistema de Gerenciamento de IPTV
APP_URL=http://localhost:3000

# Security Configuration
# Use a comma-separated allowlist when you need multiple frontend origins.
CORS_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false

# Development Notes:
# - For Docker: Use DB_HOST=mysql
# - For local development: Use DB_HOST=localhost
# - Make sure to change JWT_SECRET and NEXTAUTH_SECRET in production
