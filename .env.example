# Database Configuration
# Use 'mysql' when running `docker compose up -d`
# Use '127.0.0.1' or your remote host when running the app outside Docker
DB_HOST=mysql
DB_PORT=3306
DB_USER=iptv_user
DB_PASSWORD=iptv_password
DB_NAME=iptv_manager

# JWT Configuration
JWT_SECRET=replace-with-a-random-secret-with-at-least-32-characters
JWT_EXPIRES_IN=7d

# Next.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret-with-at-least-32-characters

# API / Session Configuration
API_PORT=3001
API_URL=http://localhost:3001
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false

# Application Configuration
APP_NAME=IPTV Manager
APP_DESCRIPTION=Sistema de Gerenciamento de IPTV

# Dokploy / VPS Notes:
# - Build Type: Railpack
# - The public app runs on PORT automatically injected by Dokploy
# - Keep API_PORT=3001 so Next.js proxies `/api/*` internally to Express
# - In production, set API_URL=http://127.0.0.1:3001
# - In production, set APP_URL/NEXTAUTH_URL/CORS_ORIGIN to https://seu-dominio.com
# - In production, set SESSION_COOKIE_SECURE=true
